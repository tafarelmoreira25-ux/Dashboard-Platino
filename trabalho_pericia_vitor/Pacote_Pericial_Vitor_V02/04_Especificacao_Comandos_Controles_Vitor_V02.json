  "consolidated_at": "2026-07-25",
  "locale": "pt-BR",
  "currency": "BRL",
  "numeric_policy": {
    "money_storage": "arbitrary_precision_decimal",
    "rate_storage": "arbitrary_precision_decimal",
    "internal_precision_digits_minimum": 34,
    "rounding_mode": "HALF_EVEN",
    "display_money_scale": 2,
    "display_rate_scale_default": 6,
    "date_standard": "ISO-8601",
    "cet_day_basis": 365,
    "tolerances": {
      "money_absolute": "0.01",
      "root_function_residual_absolute": "0.00000001",
      "root_rate_interval_width": "0.000000000001",
      "cet_npv_absolute": "0.01",
      "exact_rate_equivalence_absolute": "0.000000000001",
      "declared_rate_comparison": "derive_half_ulp_from_declared_precision"
    },
    "rules": [
      "Nunca usar binary float para resultados financeiros persistidos.",
      "Persistir valor bruto e valor de apresentação separadamente.",
      "Não encadear a memória a partir de valores exibidos e arredondados.",
      "Qualquer ajuste de última parcela deve ser explícito e rastreável.",
      "Taxa declarada arredondada deve ser tratada como intervalo de precisão; divergência de prestação dentro desse intervalo exige justificativa, não o rótulo genérico de arredondamento da parcela."
    ]
  },
