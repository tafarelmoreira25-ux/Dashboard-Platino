  "controls": [
    {
      "id": "CHK-001",
      "name": "CAMPOS_CRITICOS_CONFIRMADOS",
      "criterion": "all critical inputs are CONFIRMADO or INFERIDO with formula and confirmed inputs",
      "blocking": true
    },
    {
      "id": "CHK-002",
      "name": "RECONCILIACAO_PRINCIPAL",
      "criterion": "abs(financed_principal - reconciled_principal) <= money_absolute",
      "blocking": true
    },
    {
      "id": "CHK-003",
      "name": "PRESTACAO_E_PRECISAO_TAXA_DECLARADA",
      "criterion": "contract_payment equals theoretical payment within money tolerance OR lies inside payment interval implied by declared-rate precision with approved justification",
      "blocking": true
    },
    {
      "id": "CHK-004",
      "name": "RESIDUO_TAXA_IMPLICITA",
      "criterion": "abs(rate_equation_residual) <= root_function_residual_absolute and bracket_width <= root_rate_interval_width",
      "blocking": true
    },
    {
      "id": "CHK-005",
      "name": "EQUIVALENCIA_TAXAS",
      "criterion": "exact equivalence within exact_rate_equivalence_absolute; comparison with declared rounded rate uses declared precision",
      "blocking": true
    },
    {
      "id": "CHK-006",
      "name": "SALDO_FINAL",
      "criterion": "abs(final_balance) <= money_absolute or explicit_final_adjustment",
      "blocking": true
    },
    {
      "id": "CHK-007",
      "name": "SOMA_AMORTIZACOES",
      "criterion": "abs(sum_amortization - financed_principal) <= money_absolute",
      "blocking": true
    },
    {
      "id": "CHK-008",
      "name": "IDENTIDADE_MEMORIA",
      "criterion": "abs(sum_payments - sum_interest - sum_amortization - sum_other_events) <= money_absolute",
      "blocking": true
    },
    {
      "id": "CHK-009",
      "name": "APLICABILIDADE_E_COMPLETUDE_CET",
      "criterion": "regulatory scope assessed and all economic flows have date, signed amount, description and source",
      "blocking": true
    },
    {
      "id": "CHK-010",
      "name": "RESIDUO_CET",
      "criterion": "abs(cet_npv) <= cet_npv_absolute",
      "blocking": true
    },
    {
      "id": "CHK-011",
      "name": "COMPARABILIDADE_BENCHMARK",
      "criterion": "not used OR official description, series code, unit, reference period, borrower, product, resource type, query time, source URL, response hash and validator are present",
      "blocking": true
    },
    {
      "id": "CHK-012",
      "name": "RENDERIZACAO_E_TOKENS",
      "criterion": "zero unresolved scalar tokens; every dynamic table expanded; no INTERNAL_ONLY block in final artifact",
      "blocking": true
    },
    {
      "id": "CHK-013",
      "name": "HABILITACAO_E_REGULARIDADE",
      "criterion": "CRC verified, regularity certificate VIGENTE attached, professional function compatible, conflict check approved",
      "blocking": true
    },
    {
      "id": "CHK-014",
      "name": "REVISAO_APROVACAO_HASH",
      "criterion": "full review declaration true and approval pdf_sha256 equals exact artifact hash",
      "blocking": true
    },
    {
      "id": "CHK-015",
      "name": "VALIDACAO_ASSINATURA",
      "criterion": "signature validation is VALIDA and signed PDF hash matches published artifact",
      "blocking": true
    }
  ],
