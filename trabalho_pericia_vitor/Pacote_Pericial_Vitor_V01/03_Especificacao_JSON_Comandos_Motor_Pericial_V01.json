  "calculation_formulas": {
    "PRICE_PAYMENT": {
      "formula": "PMT = PV * i / (1 - (1 + i)^(-n))",
      "zero_rate": "PMT = PV / n"
    },
    "PRICE_ROW": {
      "formula": "J_k = SD_(k-1) * i; A_k = PMT_k - J_k; SD_k = SD_(k-1) - A_k"
    },
    "PRICE_CLOSED_FORM_BALANCE": {
      "formula": "SD_k = PV*(1+i)^k - PMT*((1+i)^k - 1)/i"
    },
    "SAC": {
      "formula": "A = PV/n; J_k = SD_(k-1)*i; PMT_k = A + J_k; SD_k = SD_(k-1) - A"
    },
    "ANNUAL_EQUIVALENCE": {
      "formula": "i_annual = (1 + i_periodic)^periods_per_year - 1"
    },
    "PERIODIC_EQUIVALENCE": {
      "formula": "i_periodic = (1 + i_annual)^(1/periods_per_year) - 1"
    },
    "IMPLICIT_RATE_REGULAR": {
      "equation": "PV - sum(PMT_k/(1+i)^k, k=1..n) = 0",
      "preferred_solver": "BRENT",
      "fallback_solver": "BISECTION"
    },
    "CET_ACTUAL_DATES": {
      "equation": "FC_0 - sum(FC_j/(1+CET)^((d_j-d_0)/365), j=1..N) = 0",
      "output_unit": "effective_annual"
    },
    "PRINCIPAL_RECONCILIATION": {
      "formula": "PV_reconciled = asset_or_credit - down_payment + sum(financed_costs) + sum(financed_taxes)"
    }
  },
