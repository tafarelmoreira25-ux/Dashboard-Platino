  "controls": [
    {
      "id": "CHK-001",
      "name": "RECONCILIACAO_PRINCIPAL",
      "criterion": "abs(financed_principal - reconciled_principal) <= money_absolute",
      "blocking": true
    },
    {
      "id": "CHK-002",
      "name": "PRESTACAO_PRICE",
      "criterion": "abs(contract_payment - theoretical_payment) <= money_absolute or justified_rounding",
      "blocking": true
    },
    {
      "id": "CHK-003",
      "name": "RESIDUO_TAXA_IMPLICITA",
      "criterion": "abs(rate_equation_residual) <= root_residual_absolute",
      "blocking": true
    },
    {
      "id": "CHK-004",
      "name": "EQUIVALENCIA_TAXAS",
      "criterion": "abs(annual_recalculated - annual_from_periodic) <= rate_comparison_absolute",
      "blocking": true
    },
    {
      "id": "CHK-005",
      "name": "SALDO_FINAL",
      "criterion": "abs(final_balance) <= money_absolute or explicit_final_adjustment",
      "blocking": true
    },
    {
      "id": "CHK-006",
      "name": "SOMA_AMORTIZACOES",
      "criterion": "abs(sum_amortization - financed_principal) <= money_absolute",
      "blocking": true
    },
    {
      "id": "CHK-007",
      "name": "IDENTIDADE_MEMORIA",
      "criterion": "abs(sum_payments - sum_interest - sum_amortization) <= money_absolute",
      "blocking": true
    },
    {
      "id": "CHK-008",
      "name": "RESIDUO_CET",
      "criterion": "abs(cet_npv) <= cet_npv_absolute",
      "blocking": true
    },
    {
      "id": "CHK-009",
      "name": "COMPLETUDE_FLUXOS_CET",
      "criterion": "all flows have date, signed amount, description and source",
      "blocking": true
    },
    {
      "id": "CHK-010",
      "name": "COMPARABILIDADE_BENCHMARK",
      "criterion": "series, period, unit and classification validated",
      "blocking_when_benchmark_used": true
    },
    {
      "id": "CHK-011",
      "name": "TOKENS_PENDENTES",
      "criterion": "final_document_unresolved_token_count == 0",
      "blocking": true
    },
    {
      "id": "CHK-012",
      "name": "REGULARIDADE_PROFISSIONAL",
      "criterion": "regularity_verified == true and certificate_is_current == true",
      "blocking": true
    },
    {
      "id": "CHK-013",
      "name": "VERSAO_ASSINADA",
      "criterion": "signed_hash == approved_pdf_sha256",
      "blocking": true
    }
  ],
