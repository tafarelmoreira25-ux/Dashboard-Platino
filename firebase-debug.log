[debug] [2026-07-20T10:22:58.493Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/platino-hub/rulesets {"name":"projects/platino-hub/rulesets/ff82692a-294c-4a1e-a814-42204aa60a89","source":{"files":[{"content":"rules_version = '2';\r\n\r\nservice cloud.firestore {\r\n  match /databases/{database}/documents {\r\n    function signedIn() {\r\n      return request.auth != null;\r\n    }\r\n\r\n    function isManagement() {\n      return signedIn()\n        && (\n          request.auth.token.get('role', '') == 'admin'\n          || request.auth.token.get('role', '') == 'manager'\n          ||\n          request.auth.uid == 'yRW5stqXWZT7ovrQyn1Fd3WNuta2'\n          || request.auth.token.email == 'gestao@platino.com'\r\n          || request.auth.token.email == 'tafarel@platino.com'\r\n          || request.auth.token.email == 'tafarel.moreira@platino.com'\r\n          || request.auth.token.email == 'tafarelmoreira@platino.com'\r\n          || request.auth.token.email == 'supervisao@platino.com'\r\n          || request.auth.token.email == 'diretoria@platino.com'\r\n          || request.auth.token.email == 'admin@platino.com'\r\n          || request.auth.token.email == 'isabela@platino.com'\n          || request.auth.token.email == 'vanessa@platino.com'\n        );\r\n    }\r\n\r\n    function isRhEditor() {\r\n      return isManagement()\r\n        || (\r\n          signedIn()\r\n          && (\r\n            request.auth.token.email == 'anna@platino.com'\r\n            || request.auth.token.email == 'emily@platino.com'\r\n            || request.auth.token.email == 'emilly@platino.com'\r\n          )\r\n        );\r\n    }\r\n\r\n    function isNoticeEditor() {\n      return isManagement()\n        || (\n          signedIn()\n          && request.auth.token.email == 'isabela@platino.com'\n        );\n    }\n\n    function isOwner(uid) {\n      return signedIn() && request.auth.uid == uid;\n    }\n\n    function validProfile() {\n      let data = request.resource.data;\n      return data.keys().hasOnly([\n          'displayName',\n          'email',\n          'photoURL',\n          'avatarDataUrl',\n          'role',\n          'disabled',\n          'createdAt',\n          'createdBy',\n          'updatedAt'\n        ])\n        && data.displayName is string\n        && data.displayName.size() > 0\n        && data.displayName.size() <= 120\n        && data.email is string\n        && data.photoURL is string\n        && data.avatarDataUrl is string\n        && data.avatarDataUrl.size() <= 200000\n        && data.role in ['admin', 'manager', 'collaborator']\n        && data.disabled is bool;\n    }\n\n    function validReminder() {\n      let data = request.resource.data;\n      return data.keys().hasOnly([\n          'title',\n          'notes',\n          'dueAt',\n          'completed',\n          'type',\n          'priority',\n          'notify',\n          'createdAt',\n          'updatedAt'\n        ])\n        && data.title is string\n        && data.title.size() > 0\n        && data.title.size() <= 200\n        && data.notes is string\n        && data.notes.size() <= 4000\n        && data.dueAt is timestamp\n        && data.completed is bool\n        && data.get('type', 'task') in ['task', 'reminder', 'goal', 'note']\n        && data.get('priority', 'normal') in ['normal', 'high', 'urgent']\n        && data.get('notify', false) is bool;\n    }\n\n    function isTimelineEditor() {\n      return isNoticeEditor()\n        || (\n          signedIn()\n          && (\n            request.auth.token.email == 'roberta@platino.com'\n            || request.auth.token.email == 'nicolas@platino.com'\n            || request.auth.token.email.matches('^roberta.*@platino[.]com$')\n            || request.auth.token.email.matches('^nicolas.*@platino[.]com$')\n          )\n        );\n    }\n\r\n    function isValidShortText(value, maxSize) {\r\n      return value is string\r\n        && value.size() > 0\r\n        && value.size() <= maxSize;\r\n    }\r\n\r\n    function isValidFeedbackCreate() {\r\n      let data = request.resource.data;\r\n      return request.resource.data.keys().hasOnly([\r\n          'type',\r\n          'sector',\r\n          'subject',\r\n          'message',\r\n          'anonymous',\r\n          'submittedBy',\r\n          'createdAt',\r\n          'createdAtServer',\r\n          'handled'\r\n        ])\r\n        && isValidShortText(data.type, 40)\r\n        && isValidShortText(data.sector, 80)\r\n        && isValidShortText(data.subject, 140)\r\n        && isValidShortText(data.message, 2000)\r\n        && data.anonymous is bool\r\n        && isValidShortText(data.submittedBy, 160)\r\n        && isValidShortText(data.createdAt, 40)\r\n        && data.createdAtServer is timestamp\r\n        && data.handled == false;\r\n    }\r\n\r\n    function isValidFeedbackManagementUpdate() {\r\n      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([\r\n          'handled',\r\n          'handledAt',\r\n          'handledBy'\r\n        ])\r\n        && request.resource.data.handled is bool;\r\n    }\r\n\r\n    match /appContent/{document} {\r\n      allow read: if signedIn();\r\n      allow create: if isManagement();\r\n      allow update: if isManagement()\r\n        || (\r\n          document == 'centralAvisos'\r\n          && (\n            (\n              isNoticeEditor()\n              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n                'main',\n                'notices',\n                'timelineMessages',\n                'updatedAt',\n                'updatedBy',\n                'serverUpdatedAt'\n              ])\n            )\n            || (\n              isTimelineEditor()\n              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n                'timelineMessages',\n                'updatedAt',\n                'updatedBy',\n                'serverUpdatedAt'\n              ])\n            )\n          )\n        );\n      allow delete: if false;\r\n    }\r\n\r\n    match /appContent/managementEdits {\r\n      allow read: if signedIn();\r\n      allow create, update: if isRhEditor();\r\n      allow delete: if false;\r\n    }\r\n\r\n    match /feedbacks/{feedbackId} {\r\n      allow create: if signedIn() && isValidFeedbackCreate();\r\n      allow read: if isManagement();\r\n      allow update: if isManagement() && isValidFeedbackManagementUpdate();\r\n      allow delete: if false;\r\n    }\r\n\r\n    match /laudosPericiais/{laudoId} {\n      allow create: if signedIn()\r\n        && request.resource.data.status == 'Pendente'\r\n        && request.resource.data.createdBy == request.auth.token.email;\r\n      allow read: if signedIn() && request.auth.token.email == 'administrativo@platino.com';\r\n      allow update: if signedIn()\r\n        && request.auth.token.email == 'administrativo@platino.com'\r\n        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\r\n          'status',\r\n          'validationCode',\r\n          'validationDate',\r\n          'signed',\r\n          'reviewedBy',\r\n          'reviewedAt'\r\n        ]);\r\n      allow delete: if false;\n    }\n\n    // O documento é criado pela Cloud Function (Admin SDK). No cliente, o\n    // colaborador só pode editar os campos visuais do próprio perfil.\n    match /users/{uid} {\n      allow read: if signedIn();\n      allow create: if isOwner(uid)\n        && validProfile()\n        && request.resource.data.email == request.auth.token.email\n        && request.resource.data.role == 'collaborator'\n        && request.resource.data.disabled == false\n        && request.resource.data.createdBy == uid;\n      allow delete: if false;\n      allow update: if isOwner(uid)\n        && validProfile()\n        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([\n          'displayName',\n          'photoURL',\n          'avatarDataUrl',\n          'updatedAt'\n        ]);\n\n      // O UID no caminho é a fronteira de segurança do workspace individual.\n      match /reminders/{reminderId} {\n        allow read, delete: if isOwner(uid);\n        allow create: if isOwner(uid) && validReminder();\n        allow update: if isOwner(uid) && validReminder();\n      }\n\n      match /monthlyGoals/{monthKey} {\n        allow read, delete: if isOwner(uid);\n        allow create, update: if isOwner(uid)\n          && monthKey.matches('^[0-9]{4}-[0-9]{2}$')\n          && request.resource.data.keys().hasOnly([\n            'amount',\n            'monthKey',\n            'createdAt',\n            'updatedAt'\n          ])\n          && request.resource.data.monthKey == monthKey\n          && request.resource.data.amount is number\n          && request.resource.data.amount > 0\n          && request.resource.data.amount <= 100000000;\n      }\n    }\n\n    // Auditoria é gravada exclusivamente pelo Admin SDK.\n    match /adminAudit/{auditId} {\n      allow read: if isManagement();\n      allow write: if false;\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-07-20T10:22:58.705743Z","metadata":{"services":["cloud.firestore"]}}
