rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isManagement() {
      return signedIn()
        && (
          request.auth.uid == 'yRW5stqXWZT7ovrQyn1Fd3WNuta2'
          || request.auth.token.email == 'gestao@platino.com'
          || request.auth.token.email == 'tafarel@platino.com'
          || request.auth.token.email == 'tafarel.moreira@platino.com'
          || request.auth.token.email == 'tafarelmoreira@platino.com'
          || request.auth.token.email == 'supervisao@platino.com'
          || request.auth.token.email == 'diretoria@platino.com'
          || request.auth.token.email == 'admin@platino.com'
          || request.auth.token.email == 'isabela@platino.com'
          || request.auth.token.email == 'vanessa@platino.com'
        );
    }

    function isRhEditor() {
      return isManagement()
        || (
          signedIn()
          && (
            request.auth.token.email == 'anna@platino.com'
            || request.auth.token.email == 'emily@platino.com'
            || request.auth.token.email == 'emilly@platino.com'
          )
        );
    }

    function isNoticeEditor() {
      return isManagement()
        || (
          signedIn()
          && (
            request.auth.token.email == 'isabela@platino.com'
            || request.auth.token.email == 'emily@platino.com'
            || request.auth.token.email == 'emilly@platino.com'
          )
        );
    }

    function isValidShortText(value, maxSize) {
      return value is string
        && value.size() > 0
        && value.size() <= maxSize;
    }

    function isValidFeedbackCreate() {
      let data = request.resource.data;
      return request.resource.data.keys().hasOnly([
          'type',
          'sector',
          'subject',
          'message',
          'anonymous',
          'submittedBy',
          'createdAt',
          'createdAtServer',
          'handled'
        ])
        && isValidShortText(data.type, 40)
        && isValidShortText(data.sector, 80)
        && isValidShortText(data.subject, 140)
        && isValidShortText(data.message, 2000)
        && data.anonymous is bool
        && isValidShortText(data.submittedBy, 160)
        && isValidShortText(data.createdAt, 40)
        && data.createdAtServer is timestamp
        && data.handled == false;
    }

    function isValidFeedbackManagementUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'handled',
          'handledAt',
          'handledBy'
        ])
        && request.resource.data.handled is bool;
    }

    match /appContent/{document} {
      allow read: if signedIn();
      allow create: if isManagement();
      allow update: if isManagement()
        || (
          document == 'centralAvisos'
          && isNoticeEditor()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'main',
            'notices',
            'updatedAt',
            'updatedBy',
            'serverUpdatedAt'
          ])
        );
      allow delete: if false;
    }

    match /appContent/managementEdits {
      allow read: if signedIn();
      allow create, update: if isRhEditor();
      allow delete: if false;
    }

    match /feedbacks/{feedbackId} {
      allow create: if signedIn() && isValidFeedbackCreate();
      allow read: if isManagement();
      allow update: if isManagement() && isValidFeedbackManagementUpdate();
      allow delete: if false;
    }

    match /laudosPericiais/{laudoId} {
      allow create: if signedIn()
        && request.resource.data.status == 'Pendente'
        && request.resource.data.createdBy == request.auth.token.email;
      allow read: if signedIn() && request.auth.token.email == 'administrativo@platino.com';
      allow update: if signedIn()
        && request.auth.token.email == 'administrativo@platino.com'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'validationCode',
          'validationDate',
          'signed',
          'reviewedBy',
          'reviewedAt'
        ]);
      allow delete: if false;
    }
  }
}
