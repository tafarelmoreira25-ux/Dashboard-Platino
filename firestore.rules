rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasUserProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function tokenRole() {
      return signedIn() ? request.auth.token.get('role', '') : '';
    }

    function operationalRole() {
      return hasUserProfile()
        ? userProfile().get('operationalRole', userProfile().get('role', tokenRole()))
        : tokenRole();
    }

    function isManagement() {
      return signedIn()
        && (
          request.auth.uid == 'yRW5stqXWZT7ovrQyn1Fd3WNuta2'
          || request.auth.token.email in [
            'gestao@platino.com',
            'tafarel@platino.com',
            'tafarel.moreira@platino.com',
            'tafarelmoreira@platino.com',
            'supervisao@platino.com',
            'diretoria@platino.com',
            'admin@platino.com',
            'isabela@platino.com',
            'vanessa@platino.com'
          ]
          || tokenRole() in ['admin', 'manager']
          || operationalRole() in ['admin', 'manager', 'gestor', 'supervisor']
        );
    }

    function isRhEditor() {
      return isManagement()
        || (signedIn() && request.auth.token.email in [
          'anna@platino.com',
          'emily@platino.com',
          'emilly@platino.com'
        ]);
    }

    function isNoticeEditor() {
      return isManagement()
        || (signedIn() && request.auth.token.email == 'isabela@platino.com');
    }

    function isTimelineEditor() {
      return isNoticeEditor()
        || (
          signedIn()
          && (
            request.auth.token.email in ['roberta@platino.com', 'nicolas@platino.com']
            || request.auth.token.email.matches('^roberta.*@platino[.]com$')
            || request.auth.token.email.matches('^nicolas.*@platino[.]com$')
          )
        );
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isSdrUser() {
      return signedIn()
        && (
          request.auth.token.email in [
            'comercial@platino.com',
            'roberta@platino.com',
            'janaina@platino.com',
            'rafaela@platino.com',
            'fernanda@platino.com',
            'geovanna@platino.com'
          ]
          || request.auth.token.email.matches('^[a-z0-9._-]+[.]sdr@platino[.]com$')
          || operationalRole() in ['sdr', 'SDR']
        );
    }

    function isConsultantUser() {
      return signedIn()
        && (
          request.auth.token.email in [
            'giullian@platino.com',
            'nicolas@platino.com',
            'tabata@platino.com',
            'elaine@platino.com'
          ]
          || operationalRole() in [
            'consultant',
            'consultor',
            'consultor_comercial',
            'analyst',
            'analista'
          ]
        );
    }

    function leadData(leadId) {
      return get(/databases/$(database)/documents/sdrLeads/$(leadId)).data;
    }

    function canReadLeadData(data) {
      return signedIn()
        && (
          isManagement()
          // Todo usuário autenticado pode criar leads pela API e precisa
          // acompanhar os cadastros dos quais é autor.
          || data.ownerSdrId == request.auth.uid
          || (isConsultantUser() && data.assignedConsultantId == request.auth.uid)
        );
    }

    function canReadLead(leadId) {
      return canReadLeadData(leadData(leadId));
    }

    function validProfile() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'displayName',
          'email',
          'photoURL',
          'avatarDataUrl',
          'role',
          'operationalRole',
          'sector',
          'isActive',
          'availabilityStatus',
          'lastActivityAt',
          'disabled',
          'createdAt',
          'createdBy',
          'updatedAt'
        ])
        && data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 120
        && data.email is string
        && data.photoURL is string
        && data.avatarDataUrl is string
        && data.avatarDataUrl.size() <= 200000
        && data.role in ['admin', 'manager', 'collaborator']
        && data.get('operationalRole', 'collaborator') in [
          'admin', 'manager', 'sdr', 'consultant', 'analyst', 'collaborator'
        ]
        && data.get('sector', '') is string
        && data.get('isActive', true) is bool
        && data.get('availabilityStatus', '') is string
        && data.disabled is bool;
    }

    function validReminder() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'title',
          'notes',
          'dueAt',
          'completed',
          'type',
          'priority',
          'notify',
          'createdAt',
          'updatedAt'
        ])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 200
        && data.notes is string
        && data.notes.size() <= 4000
        && data.dueAt is timestamp
        && data.completed is bool
        && data.get('type', 'task') in ['task', 'reminder', 'goal', 'note']
        && data.get('priority', 'normal') in ['normal', 'high', 'urgent']
        && data.get('notify', false) is bool;
    }

    function isValidShortText(value, maxSize) {
      return value is string && value.size() > 0 && value.size() <= maxSize;
    }

    function isValidFeedbackCreate() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'type',
          'sector',
          'subject',
          'message',
          'anonymous',
          'submittedBy',
          'createdAt',
          'createdAtServer',
          'handled'
        ])
        && isValidShortText(data.type, 40)
        && isValidShortText(data.sector, 80)
        && isValidShortText(data.subject, 140)
        && isValidShortText(data.message, 2000)
        && data.anonymous is bool
        && isValidShortText(data.submittedBy, 160)
        && isValidShortText(data.createdAt, 40)
        && data.createdAtServer is timestamp
        && data.handled == false;
    }

    function isValidFeedbackManagementUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'handled',
          'handledAt',
          'handledBy'
        ])
        && request.resource.data.handled is bool;
    }

    function isValidIsabelaTributeCreate() {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'authorUid',
          'authorName',
          'department',
          'message',
          'messageHash',
          'status',
          'createdAt',
          'createdAtIso'
        ])
        && data.authorUid == request.auth.uid
        && isValidShortText(data.authorName, 120)
        && isValidShortText(data.department, 100)
        && isValidShortText(data.message, 400)
        && data.messageHash is string
        && data.messageHash.matches('^[0-9a-f]{64}$')
        && data.status == 'published'
        && data.createdAt is timestamp
        && isValidShortText(data.createdAtIso, 40);
    }

    match /appContent/{document} {
      allow read: if signedIn();
      allow create: if isManagement();
      allow update: if isManagement()
        || (
          document == 'centralAvisos'
          && (
            (
              isNoticeEditor()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'main',
                'notices',
                'timelineMessages',
                'updatedAt',
                'updatedBy',
                'serverUpdatedAt'
              ])
            )
            || (
              isTimelineEditor()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'timelineMessages',
                'updatedAt',
                'updatedBy',
                'serverUpdatedAt'
              ])
            )
          )
        );
      allow delete: if false;
    }

    match /appContent/managementEdits {
      allow read: if signedIn();
      allow create, update: if isRhEditor();
      allow delete: if false;
    }

    match /feedbacks/{feedbackId} {
      allow create: if signedIn() && isValidFeedbackCreate();
      allow read: if isManagement();
      allow update: if isManagement() && isValidFeedbackManagementUpdate();
      allow delete: if false;
    }

    match /isabelaTributes/{tributeId} {
      allow read: if signedIn();
      allow create: if signedIn() && isValidIsabelaTributeCreate();
      // Recados publicados compõem um mural compartilhado e imutável.
      allow update, delete: if false;
    }

    // Todas as mutações críticas do SDR passam pela API com Admin SDK.
    match /sdrLeads/{leadId} {
      allow read: if canReadLeadData(resource.data);
      allow write: if false;
    }

    match /sdrLeadEvents/{eventId} {
      allow read: if canReadLead(resource.data.leadId);
      allow write: if false;
    }

    match /sdrLeadComments/{commentId} {
      allow read: if canReadLead(resource.data.leadId);
      allow write: if false;
    }

    match /sdrLeadAssignments/{assignmentId} {
      allow read: if canReadLead(resource.data.leadId);
      allow write: if false;
    }

    match /sdrLeadSimulations/{simulationId} {
      allow read: if canReadLead(resource.data.leadId);
      allow write: if false;
    }

    match /sdrLeadAnalysisDocuments/{documentId} {
      allow read: if canReadLead(resource.data.leadId);
      allow write: if false;
    }

    match /sdrLeadOutcomes/{outcomeId} {
      allow read: if canReadLead(resource.data.leadId);
      allow write: if false;
    }

    match /sdrNotifications/{notificationId} {
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || isManagement());
      allow write: if false;
    }

    match /sdrBankCatalog/{bankId} {
      allow read: if signedIn();
      allow create, update: if isManagement();
      allow delete: if false;
    }

    match /sdrSimulationRules/{ruleId} {
      allow read: if signedIn();
      allow create, update: if isManagement();
      allow delete: if false;
    }

    match /sdrCounters/{counterId} {
      allow read, write: if false;
    }

    match /sdrAuditLogs/{auditId} {
      allow read: if isManagement();
      allow write: if false;
    }

    // O documento é criado pela API. No cliente, a pessoa edita apenas seu perfil visual.
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isOwner(uid)
        && validProfile()
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'collaborator'
        && request.resource.data.disabled == false
        && request.resource.data.createdBy == uid;
      allow delete: if false;
      allow update: if isOwner(uid)
        && validProfile()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName',
          'photoURL',
          'avatarDataUrl',
          'updatedAt',
          'availabilityStatus',
          'lastActivityAt'
        ]);

      match /reminders/{reminderId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && validReminder();
      }

      match /monthlyGoals/{monthKey} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && monthKey.matches('^[0-9]{4}-[0-9]{2}$')
          && request.resource.data.keys().hasOnly([
            'amount',
            'monthKey',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.monthKey == monthKey
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.amount <= 100000000;
      }
    }

    match /adminAudit/{auditId} {
      allow read: if isManagement();
      allow write: if false;
    }
  }
}
